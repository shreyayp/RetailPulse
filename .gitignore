# ==============================
# Python environment and cache
# ==============================
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==============================
# IDE and operating system
# ==============================
.DS_Store
.vscode/
.idea/

# ==============================
# Secrets and environment files
# ==============================
.env
.env.*
.streamlit/secrets.toml

# ==============================
# Raw source data
# Keep original CSV files in GitHub
# ==============================
# Do not ignore data/raw/
# RetailPulse needs these files:
# data/raw/retail_sales_ml_apl.csv
# data/raw/retail_inventory_ml_apl.csv

# ==============================
# Processed data
# Generated by the ETL pipeline
# ==============================
data/processed/*
!data/processed/.gitkeep

# ==============================
# Reports
# Generated during pipeline execution
# ==============================
reports/*
!reports/.gitkeep

# ==============================
# Databases
# Generated SQLite files
# ==============================
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

